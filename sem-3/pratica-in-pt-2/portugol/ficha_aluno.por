algoritmo "FichaAluno"

procedimento ficha_do_aluno(nome: caractere; idade: inteiro; curso: caractere)
inicio
   escreval("--- Ficha do Aluno ---")
   escreval("Nome: ", nome)
   escreval("Idade: ", idade)
   escreval("Curso: ", curso)
fimprocedimento

inicio
   ficha_do_aluno("Ana Silva", 22, "Ciência da Computação")
fimalgoritmo
